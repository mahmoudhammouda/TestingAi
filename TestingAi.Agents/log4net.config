<?xml version="1.0" encoding="utf-8" ?>
<log4net>

  <!-- ── Appender : fichier rotatif pour les agents ───────────────────────── -->
  <appender name="AgentsRollingFile" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/agents.log" />
    <appendToFile value="true" />
    <rollingStyle value="Composite" />
    <datePattern value="yyyy-MM-dd" />
    <maxSizeRollBackups value="10" />
    <maximumFileSize value="10MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} [%thread] %-5level %logger{1} — %message%newline" />
    </layout>
  </appender>

  <!-- ── Appender : console (utile pour les tests et le debug) ────────────── -->
  <appender name="Console" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{HH:mm:ss} %-5level [Agents] %logger{1} — %message%newline" />
    </layout>
  </appender>

  <!-- ── Logger racine ────────────────────────────────────────────────────── -->
  <root>
    <level value="DEBUG" />
    <appender-ref ref="AgentsRollingFile" />
    <appender-ref ref="Console" />
  </root>

</log4net>
